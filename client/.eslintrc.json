{
    "env": {
      "browser": true,
      "es2021": true,
      "jest": true
    },
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended",
      "plugin:jest/recommended",
      "plugin:testing-library/react"
    ],
    "plugins": [
      "react",
      "jest",
      "testing-library"
    ],
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "ecmaVersion": 12,
      "sourceType": "module"
    },
    "rules": {
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  }